{
  "name": "flashusdt-gateway",
  "version": "1.0.0",
  "description": "A high-performance gateway for USDT transfers across TRC20, BEP20, ERC20, BTC, and Fantom networks",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:performance": "jest --testPathPattern=tests/performance",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "benchmark": "node tests/performance/benchmark.js"
  },
  "keywords": [
    "usdt",
    "cryptocurrency",
    "blockchain",
    "trc20",
    "erc20",
    "bep20",
    "bitcoin",
    "fantom",
    "gateway"
  ],
  "author": "",
  "license": "PROPRIETARY",
  "dependencies": {
    "express": "^4.18.2",
    "web3": "^4.3.0",
    "ethers": "^6.9.0",
    "tronweb": "^5.3.0",
    "bitcoinjs-lib": "^6.1.5",
    "ioredis": "^5.3.2",
    "bull": "^4.11.5",
    "pg": "^8.11.3",
    "sequelize": "^6.35.1",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "autocannon": "^7.14.0",
    "clinic": "^13.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
