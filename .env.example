# Server Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flashusdt_gateway
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_POOL_MAX=20
DB_POOL_MIN=5

# Redis Configuration (for caching and queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cache TTL (in milliseconds)
CACHE_TTL_BALANCE=30000
CACHE_TTL_GAS_PRICE=15000
CACHE_TTL_NETWORK_STATUS=60000

# TRC20 (TRON) Configuration
TRC20_RPC_URL=https://api.trongrid.io
TRC20_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRC20_RATE_LIMIT=10

# ERC20 (Ethereum) Configuration
ERC20_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
ERC20_CONTRACT_ADDRESS=0xdac17f958d2ee523a2206206994597c13d831ec7
ERC20_RATE_LIMIT=10
ERC20_GAS_MULTIPLIER=1.2

# BEP20 (Binance Smart Chain) Configuration
BEP20_RPC_URL=https://bsc-dataseed.binance.org
BEP20_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
BEP20_RATE_LIMIT=10
BEP20_GAS_MULTIPLIER=1.1

# BTC Configuration
BTC_RPC_URL=https://blockstream.info/api
BTC_RATE_LIMIT=5

# Fantom Configuration
FANTOM_RPC_URL=https://rpc.ftm.tools
FANTOM_CONTRACT_ADDRESS=0x049d68029688eabf473097a2fc38ef61633a3c7a
FANTOM_RATE_LIMIT=10

# Transaction Monitoring
TX_POLL_MAX_ATTEMPTS=20
TX_POLL_INITIAL_DELAY=1000
TX_POLL_MAX_DELAY=30000

# Security (REQUIRED: Replace with cryptographically secure random values)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_TO_RANDOM_256_BIT_KEY_MINIMUM_64_CHARS
API_KEY=CHANGE_TO_RANDOM_256_BIT_KEY_MINIMUM_64_CHARS

# Performance Monitoring
ENABLE_PERFORMANCE_TRACKING=true
PERFORMANCE_LOG_INTERVAL=60000

# Worker Configuration
WORKER_CONCURRENCY=5
WORKER_MAX_RETRIES=3

# API Configuration
API_TIMEOUT=30000
API_MAX_PAYLOAD_SIZE=1mb
