# FlashUSDT Gateway Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Network RPC Endpoints
TRC20_RPC_URL=https://api.trongrid.io
ERC20_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
BEP20_RPC_URL=https://bsc-dataseed.binance.org
FANTOM_RPC_URL=https://rpc.ftm.tools
BTC_RPC_URL=https://blockstream.info/api

# Wallet Configuration (Add your private keys securely)
# WARNING: Never commit actual private keys to version control
WALLET_PRIVATE_KEY=your_private_key_here

# API Keys (if needed)
INFURA_API_KEY=your_infura_key
ETHERSCAN_API_KEY=your_etherscan_key
BSCSCAN_API_KEY=your_bscscan_key

# Security
JWT_SECRET=your_jwt_secret_here
API_KEY=your_api_key_here

# Transaction Limits
MAX_TRANSACTION_AMOUNT=10000
MIN_TRANSACTION_AMOUNT=1

# Gas Settings
GAS_PRICE_MULTIPLIER=1.2
MAX_GAS_PRICE=100
